{
  "name": "comsy-specs-monitor",
  "version": "1.0.0",
  "main": "launcher.js",
  "scripts": {
    "start": "node launcher.js",
    "package-win": "pkg . --targets node18-win-x64 --output dist/ComsySpecsMonitor.exe",
    "install-service": "node install-service.js",
    "uninstall-service": "node uninstall-service.js"
  },
  "author": "Ayush More",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "mongoose": "^8.13.0",
    "node-windows": "^1.0.0-beta.8",
    "ping": "^0.4.2",
    "systeminformation": "^5.18.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "bin": "launcher.js",
  "pkg": {
    "assets": [
      "*.js",
      "node_modules/**/*"
    ],
    "scripts": [
      "launcher.js",
      "main.js",
      "install-service.js"
    ],
    "targets": [
      "node18-win-x64"
    ]
  }
}